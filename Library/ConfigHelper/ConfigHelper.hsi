bool_ReturnValue = ASWGLOBAL::BOOL::TRUE;
// }} ""
// {{ 347 1 0 "0d83e1de_9793_44ec_9b6567f2413d3052" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
if (str_DataDefinition != "")
{
// }} ""
{
   object objCfgFile;

   objCfgFile.CreateObject("HXCFGFILLIB.HxCfgFile");
   objCfgFile.LoadFile(i_str_ConfigFilePath);

   onerror goto HandleError;

   if(objCfgFile.ExistDataDef(str_DataDefinition,str_Instance) == 1)
   {
      //Trace("Key: ",i_str_ValueToSearch," :: ",i_Value);
      if(i_int_ReturnValue == 0 || i_int_ReturnValue == 3) objCfgFile.PutStringValueInDataDef(str_DataDefinition,1,str_Instance,i_str_ValueToSearch,i_Value);
      if(i_int_ReturnValue == 1) objCfgFile.PutLongValueInDataDef(str_DataDefinition,1,str_Instance,i_str_ValueToSearch,i_Value);
      if(i_int_ReturnValue == 2) objCfgFile.PutFloatValueInDataDef(str_DataDefinition,1,str_Instance,i_str_ValueToSearch,i_Value);
      objCfgFile.StoreFile(objCfgFile.FileSpec,objCfgFile.CfgStatus);
   }
   onerror goto 0;
   err.Clear();

   objCfgFile.ReleaseObject();

   HandleError:
   {
   objCfgFile.ReleaseObject();
   }
}
