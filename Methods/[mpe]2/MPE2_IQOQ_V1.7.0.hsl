// {{ 43 1 0 "cdb5973b_6f56_43b6_8ea5f98d3ac5a854" "{586C3429-F931-405f-9938-928E22C90BFA}"

// }} ""
{
   variable strMethodName;
   variable strMethodFolder;
   variable blnFileExists;
   variable strTempName;
   object objNetObject;

   strMethodName = GetFileName();
   strMethodFolder = HSLExtensions::File::GetDirectoryName(strMethodName);
   strMethodFolder = strMethodFolder + "\\Resources\\";
   HSLExtensions::Directory::Create(strMethodFolder);
   t_strConfigFilePath = strMethodFolder + "MPE2Config.cfg";
   t_strConfigBalancePath = strMethodFolder + "BalanceConfig.cfg";
   t_strMonitorEvapFilePath = strMethodFolder + "EvaporatorTemps.csv";
   t_strMonitorPressureFilePath = strMethodFolder + "PressureValues.csv";
   t_strMeasuredWeightFilePath = strMethodFolder + "WeightMeasured.csv";

   objNetObject.CreateObject("WScript.Network");
   t_strComputerName = objNetObject.ComputerName;
   Trace("Computer Name:  ",t_strComputerName);
   objNetObject.ReleaseObject();

   blnFileExists = HSLExtensions::File::Exists(t_strConfigFilePath);

   HSLExtensions::File::Delete(t_strConfigBalancePath);

   if(!blnFileExists)
   {
      Settings_SetConfig();
      Settings_SetAccessories();
   }
   else
   {
      CONFIGHELPER::VALUE_GetValue(t_strConfigFilePath,"Computer","Check","Name",0,strTempName);
      if(strTempName != t_strComputerName)
      {
         HSLExtensions::File::Delete(t_strConfigFilePath);
         //HSLExtensions::File::Delete(t_strConfigBalancePath);
         CONFIGHELPER::CREATE_AddNewValue(t_strConfigFilePath,"Computer","Check","Name",0,t_strComputerName);
         Settings_SetConfig();
         Settings_SetAccessories();
      }
   }
}
