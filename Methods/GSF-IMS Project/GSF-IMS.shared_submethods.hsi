// {{{ 103 1 0 "8abfdcc8_0b3c_44de_a16add0676f413bd" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
err_str = StrConcat4(err_str, Translate("The number of positions in asp_seq ("), asp_len_str, Translate(") "));
// }} ""
// {{{ 104 1 0 "f1a2eccb_e7ca_4ae3_a7546768b549609b" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
chan_len_str = StrIStr(number_channels);
// }} ""
// {{{ 105 1 0 "1e2a65f1_7125_419f_b2f163c7f8ce0667" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
