asp_seq_length = SeqGetTotal(asp_seq);
// }} ""
// {{ 100 1 0 "ccdbeac0_a1d4_40f6_9210f7555704211e" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
if (asp_seq_length != number_channels)
{
// }} ""
// {{ 101 1 0 "988313f2_29d2_4c3c_9e349ad50d20c772" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
err_str = Translate("Error in pipette_cells_from_tubes sub-method: ");
