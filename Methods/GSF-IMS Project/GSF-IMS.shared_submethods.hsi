// {{{ 96 1 0 "37eb679c_b953_4bc8_93c8b2804d1921d9" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
check_seq_lengths_and_channels(asp_seq, disp_seq, number_channels);
// }} ""
// {{ 97 1 0 "1723c298_8f8c_4d6f_97a6ba21f52e1827" "{586C3429-F931-405f-9938-928E22C90BFA}"

