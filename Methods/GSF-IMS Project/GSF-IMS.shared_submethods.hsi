// {{{ 5 "pipette_media" "Begin"
function pipette_media( sequence & asp_seq, sequence & disp_seq, variable p_vol, variable pre_wet_tips, sequence & tips, variable number_channels, device & STAR ) void {
// }} ""
private variable pipette_loop;
// {{ 5 "pipette_media" "InitLocals"
// }} ""
// {{ 146 1 0 "2cc44b74_2bfb_4cbb_bae8c2e1b3422e2d" "{F07B0071-8EFC-11d4-A3BA-002035848439}"
MECC::TraceComment(Translate("**** start pipette_media shared sub-method ****"));
// }} ""
// {{{ 147 1 0 "021297fc_6e2e_46ee_b471c3163e76c678" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
TrcTrace(Translate("p_vol: "), p_vol);
// }} ""
// {{{ 148 1 0 "992a8e74_f683_49f0_8d6165f3728cec1f" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
check_seq_lengths_and_channels(asp_seq, disp_seq, number_channels);
// }} ""
// {{ 149 1 0 "3fae873b_dd26_475c_ae04e4c53d081ead" "{F07B0071-8EFC-11d4-A3BA-002035848439}"

// }} ""
// {{ 150 1 0 "2b2efdd0_9d75_41d5_a9ee8027c4676620" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
if (pre_wet_tips == 1)
{
// }} ""
// {{{ 151 1 0 "fe9ca302_b005_4771_8e3a236a60f66f16" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
simple_aspirate(asp_seq, 0, p_vol, tips, number_channels, STAR);
// }} ""
// {{{ 152 1 0 "d7e7b647_caeb_43bb_89b563ce3e5a88a3" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
simple_dispense(asp_seq, 0, 1, p_vol, 0, 0, number_channels, STAR);
// }} ""
// {{ 153 1 0 "2b2efdd0_9d75_41d5_a9ee8027c4676620" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
}
// }} ""
// {{ 154 1 0 "782e7cba_7e60_4751_89e305dc060a524f" "{B31F3532-5D80-11d4-A5EB-0050DA737D89}"
{
pipette_loop = 0;
disp_seq.SetCurrentPosition(1);
while (
   (disp_seq.GetCurrentPosition() > 0)
)
{
AlignSequences(hslTrue, disp_seq, 1);
pipette_loop = pipette_loop + 1;
// }} ""
// {{{ 155 1 0 "42c34d53_35ef_4ca2_a2f5da2701280ce9" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
simple_aspirate(asp_seq, 0, p_vol, tips, number_channels, STAR);
// }} ""
// {{{ 156 1 0 "f3772016_d849_4c08_a99a440ebbdf9273" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
simple_dispense(disp_seq, 1, 0, p_vol, 0, 0, number_channels, STAR);
// }} ""
// {{ 157 1 0 "782e7cba_7e60_4751_89e305dc060a524f" "{B31F3532-5D80-11d4-A5EB-0050DA737D89}"
if (
   (disp_seq.GetCurrentPosition() > 0 && disp_seq.GetMax() == 0 )
)
{ MECC::EndlessSequenceLoopWarning(GetFileName()); }

}
disp_seq.SetMax(disp_seq.GetTotal());
disp_seq.SetCurrentPosition(1);
}
// }} ""
// {{ 158 1 0 "965c7df3_0f81_4eb5_a0b3c6059afee706" "{F07B0071-8EFC-11d4-A3BA-002035848439}"
MECC::TraceComment(Translate("**** end pipette_media shard sub-method ****"));
// }} ""
// {{{ 5 "pipette_media" "End"
}
// }} ""
