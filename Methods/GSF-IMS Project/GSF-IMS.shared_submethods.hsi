check_seq_lengths_and_channels(asp_seq, disp_seq, number_channels);
// }} ""
// {{{ 226 1 0 "ce5da802_eb52_4fee_a0fde009eca24caf" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
check_p_vol_arr_disp_seq(vol_arr_length, number_channels, disp_seq);
// }} ""
// {{ 227 1 0 "5eac69e9_7237_45c4_b2e027ad60f1114f" "{F07B0071-8EFC-11d4-A3BA-002035848439}"

// }} ""
// {{ 228 1 0 "da8bc939_e961_4324_a51d22c6896291dd" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
if (pre_wet_tips == 1)
{
// }} ""
// {{{ 229 1 0 "62580f3b_52d5_4e6a_91ebecd45fe96cc0" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
p_vol = get_array_max(p_vol_arr);
// }} ""
// {{{ 230 1 0 "c74a196e_fa8d_48f2_b1097f544502f190" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
simple_aspirate(asp_seq, 0, p_vol, tips, number_channels, STAR);
// }} ""
// {{{ 231 1 0 "38f5b62e_5766_426c_9eedbffe183d8505" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
simple_dispense(asp_seq, 0, 1, p_vol, 0, 0, number_channels, STAR);
// }} ""
// {{ 232 1 0 "da8bc939_e961_4324_a51d22c6896291dd" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
}
// }} ""
// {{ 233 1 0 "9fd4f3e5_5ba8_4707_bf6ffef87401a87b" "{B31F3532-5D80-11d4-A5EB-0050DA737D89}"
{
pipette_loop = 0;
disp_seq.SetCurrentPosition(1);
while (
   (disp_seq.GetCurrentPosition() > 0)
)
{
AlignSequences(hslTrue, disp_seq, 1);
pipette_loop = pipette_loop + 1;
// }} ""
// {{ 234 1 0 "bfadfd23_9eb5_44df_9b1c34d742e158fc" "{67A8F1C9-6546-41e9-AD2F-3C54F7818853}"
p_vol=p_vol_arr.GetAt(pipette_loop-1);
// }} ""
// {{{ 235 1 0 "51c9bdc3_2c64_42a8_b25442ad86a3b0f4" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
simple_aspirate(asp_seq, 0, p_vol, tips, number_channels, STAR);
// }} ""
// {{{ 236 1 0 "4353265e_f7f3_4c1a_b979d665224739fb" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
simple_dispense(disp_seq, 1, 0, p_vol, 0, 0, number_channels, STAR);
// }} ""
// {{ 237 1 0 "9fd4f3e5_5ba8_4707_bf6ffef87401a87b" "{B31F3532-5D80-11d4-A5EB-0050DA737D89}"
if (
   (disp_seq.GetCurrentPosition() > 0 && disp_seq.GetMax() == 0 )
)
{ MECC::EndlessSequenceLoopWarning(GetFileName()); }

}
disp_seq.SetMax(disp_seq.GetTotal());
disp_seq.SetCurrentPosition(1);
}
// }} ""
// {{ 238 1 0 "c79a596d_cb65_4f96_ac571e9e932f46e7" "{F07B0071-8EFC-11d4-A3BA-002035848439}"
MECC::TraceComment(Translate("**** end pipette_media_volume_arr shard sub-method ****"));
// }} ""
// {{{ 5 "pipette_media_volume_arr" "End"
}
