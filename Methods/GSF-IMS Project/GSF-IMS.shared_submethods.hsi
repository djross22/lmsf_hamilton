// {{{ 5 "pipette_media_volume_arr" "Begin"
function pipette_media_volume_arr( sequence & asp_seq, sequence & disp_seq, variable & p_vol_arr[], variable pre_wet_tips, sequence & tips, variable number_channels, device & STAR ) void {
// }} ""
private variable pipette_loop;
private variable vol_arr_length;
private variable loopCounter1;
private variable p_vol;
// {{ 5 "pipette_media_volume_arr" "InitLocals"
// }} ""
// {{ 219 1 0 "05c82a9d_70fe_477b_8564f04ed1cf7aac" "{F07B0071-8EFC-11d4-A3BA-002035848439}"
