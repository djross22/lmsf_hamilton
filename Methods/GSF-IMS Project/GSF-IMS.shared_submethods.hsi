// {{{ 5 "check_p_vol_arr_disp_seq" "Begin"
private function check_p_vol_arr_disp_seq( variable vol_arr_length, variable number_channels, sequence disp_seq ) void {
// }} ""
private variable disp_len_str;
private variable disp_seq_length;
private variable vol_arr_check_size;
private variable err_str;
private variable vol_len_str;
private variable chan_len_str;
// {{ 5 "check_p_vol_arr_disp_seq" "InitLocals"
// }} ""
// {{ 75 1 0 "8271fdd8_ce39_47c3_a02d00b2d2a93262" "{F07B0071-8EFC-11d4-A3BA-002035848439}"

// }} ""
// {{ 76 1 0 "6d5ec7a6_2659_4db8_991d2a9e9b25e00a" "{B31F3544-5D80-11d4-A5EB-0050DA737D89}"
vol_arr_check_size = vol_arr_length * number_channels;
// }} ""
// {{{ 77 1 0 "32420109_56f8_49b9_807ffbb13d31a18b" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
disp_seq_length = SeqGetTotal(disp_seq);
// }} ""
// {{ 78 1 0 "7126f7a1_4c80_47b2_ae323fe9e6fee379" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
if (vol_arr_check_size != disp_seq_length)
{
// }} ""
// {{ 79 1 0 "235dfc48_8a23_4fe6_bfa9058f18f73ba7" "{B31F3543-5D80-11d4-A5EB-0050DA737D89}"
err_str = Translate("Error in pipette_media_volume_arr sub-method: ");
// }} ""
// {{{ 80 1 0 "ae668fbd_a2db_45b2_8af8d403ced44bff" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
disp_len_str = StrIStr(disp_seq_length);
// }} ""
// {{{ 81 1 0 "4e19c454_08de_48ca_ab79624ae92dabd7" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
vol_len_str = StrIStr(vol_arr_length);
// }} ""
// {{{ 82 1 0 "e465fa7e_9e03_484f_a20b774d002c605b" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
chan_len_str = StrIStr(number_channels);
// }} ""
// {{{ 83 1 0 "636f75ed_0965_49a0_a93cc6ea8b5b2b4e" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
err_str = StrConcat4(err_str, Translate("The number of values in p_vol_arr ("), vol_len_str, Translate(") "));
// }} ""
// {{{ 84 1 0 "f3c3a179_df6e_41ac_92b5059d600e6100" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
err_str = StrConcat4(err_str, Translate("is not equal to the length of disp_seq ("), disp_len_str, Translate(") "));
// }} ""
// {{{ 85 1 0 "e4c57350_cbf4_4a0a_86c86eac28741c91" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
err_str = StrConcat4(err_str, Translate("divided by the number of pipetting channels used ("), chan_len_str, Translate(") "));
// }} ""
// {{{ 86 1 0 "ec385f23_1081_40ac_95dab05ba07f7ab6" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
ErrRaise(1, err_str);
// }} ""
// {{ 87 1 0 "7126f7a1_4c80_47b2_ae323fe9e6fee379" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
}
// }} ""
// {{{ 5 "check_p_vol_arr_disp_seq" "End"
}
// }} ""
// {{{ 5 "get_array_max" "Begin"
function get_array_max( variable & flt_val_arr[] ) variable {
// }} ""
private variable arr_len;
private variable max_val;
private variable loopCounter1;
// {{ 5 "get_array_max" "InitLocals"
// }} ""
// {{ 146 1 0 "0c6fde64_8cc0_416e_afe5b5098f5ebdd1" "{72EACF88-8D49-43e3-92C8-2F90E81E3260}"
arr_len=flt_val_arr.GetSize();
// }} ""
// {{ 147 1 0 "80f809d3_5732_411d_845bbf23a6490338" "{67A8F1C9-6546-41e9-AD2F-3C54F7818853}"
max_val=flt_val_arr.GetAt(1-1);
// }} ""
// {{ 148 1 0 "f8224ac9_c065_43e1_bcbb351682e6c738" "{B31F3532-5D80-11d4-A5EB-0050DA737D89}"
{
for(loopCounter1 = 0; loopCounter1 < arr_len;)
{
loopCounter1 = loopCounter1 + 1;
// }} ""
// {{ 149 1 0 "42874b53_c19a_477d_8b7f1581ad4cc5d8" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
if (flt_val_arr.ElementAt( loopCounter1 -1) > max_val)
{
// }} ""
// {{ 150 1 0 "c5e22d78_cf6d_47df_85b19792964fa089" "{67A8F1C9-6546-41e9-AD2F-3C54F7818853}"
max_val=flt_val_arr.GetAt(loopCounter1-1);
// }} ""
// {{ 151 1 0 "42874b53_c19a_477d_8b7f1581ad4cc5d8" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
}
// }} ""
// {{ 152 1 0 "f8224ac9_c065_43e1_bcbb351682e6c738" "{B31F3532-5D80-11d4-A5EB-0050DA737D89}"
}
}
// }} ""
// {{{ 153 1 0 "902855f9_cfc9_4eed_abb40d2cd547aeb4" "{9EC997CD-FD3B-4280-811B-49E99DCF062C}"
return (max_val);
// }} ""
// {{{ 5 "get_array_max" "End"
}
