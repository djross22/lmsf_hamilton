function _InitLibrary() {
// {{ 2 "AutoInitBlock" ""
PTL::SetWashingStateDefault("RinseTime1", 5);
PTL::SetWashingStateDefault("SoakTime1", 5);
PTL::SetWashingStateDefault("FlowRate1", 11);
PTL::SetWashingStateDefault("RinseTime2", 0);
PTL::SetWashingStateDefault("SoakTime2", 0);
PTL::SetWashingStateDefault("FlowRate2", 11);
PTL::SetWashingStateDefault("DrainingTime", 10);
PTL::SetWashingStateDefault("StartWashLiquid", 0);
PTL::SetLoadingStateDefault("RecoveryOptionContinue", hslTrue);
PTL::SetLoadingStateDefault("RecoveryOptionExclude", hslTrue);
PTL::SetLoadingStateDefault("RecoveryOptionDefault", 0);
PTL::SetLoadingStateDefault("KitLotCheckEnabled", hslFalse);
STAR_TIP_TOOLS::_InitLibrary();
LMSF_UTILITIES::_InitLibrary();
// }} ""
}
function _ExitLibrary() {
// {{ 2 "AutoExitBlock" ""
STAR_TIP_TOOLS::_ExitLibrary();
LMSF_UTILITIES::_ExitLibrary();
// }} ""
}
// {{{ 5 "pipette_media" "Begin"
function pipette_media( sequence & asp_seq, sequence & disp_seq, variable p_vol, variable pre_wet_tips, sequence & tips, variable number_channels, device & STAR ) void {
// }} ""
private variable pipette_loop;
// {{ 5 "pipette_media" "InitLocals"
// }} ""
// {{ 205 1 0 "2cc44b74_2bfb_4cbb_bae8c2e1b3422e2d" "{F07B0071-8EFC-11d4-A3BA-002035848439}"
MECC::TraceComment(Translate("**** start pipette_media shared sub-method ****"));
// }} ""
// {{{ 206 1 0 "021297fc_6e2e_46ee_b471c3163e76c678" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
TrcTrace(Translate("p_vol: "), p_vol);
// }} ""
// {{{ 207 1 0 "992a8e74_f683_49f0_8d6165f3728cec1f" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
check_seq_lengths_and_channels(asp_seq, disp_seq, number_channels);
// }} ""
// {{ 208 1 0 "3fae873b_dd26_475c_ae04e4c53d081ead" "{F07B0071-8EFC-11d4-A3BA-002035848439}"

// }} ""
// {{ 209 1 0 "2b2efdd0_9d75_41d5_a9ee8027c4676620" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
if (pre_wet_tips == 1)
{
// }} ""
// {{{ 210 1 0 "fe9ca302_b005_4771_8e3a236a60f66f16" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
simple_aspirate(asp_seq, 0, p_vol, tips, number_channels, STAR);
// }} ""
// {{{ 211 1 0 "d7e7b647_caeb_43bb_89b563ce3e5a88a3" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
simple_dispense(asp_seq, 0, 1, p_vol, 0, 0, number_channels, STAR);
// }} ""
// {{ 212 1 0 "2b2efdd0_9d75_41d5_a9ee8027c4676620" "{B31F3531-5D80-11d4-A5EB-0050DA737D89}"
}
// }} ""
// {{ 213 1 0 "782e7cba_7e60_4751_89e305dc060a524f" "{B31F3532-5D80-11d4-A5EB-0050DA737D89}"
{
pipette_loop = 0;
disp_seq.SetCurrentPosition(1);
while (
   (disp_seq.GetCurrentPosition() > 0)
)
{
AlignSequences(hslTrue, disp_seq, 1);
pipette_loop = pipette_loop + 1;
// }} ""
// {{{ 214 1 0 "42c34d53_35ef_4ca2_a2f5da2701280ce9" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
simple_aspirate(asp_seq, 0, p_vol, tips, number_channels, STAR);
// }} ""
// {{{ 215 1 0 "f3772016_d849_4c08_a99a440ebbdf9273" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
simple_dispense(disp_seq, 1, 0, p_vol, 0, 0, number_channels, STAR);
// }} ""
// {{ 216 1 0 "782e7cba_7e60_4751_89e305dc060a524f" "{B31F3532-5D80-11d4-A5EB-0050DA737D89}"
if (
   (disp_seq.GetCurrentPosition() > 0 && disp_seq.GetMax() == 0 )
)
{ MECC::EndlessSequenceLoopWarning(GetFileName()); }

}
disp_seq.SetMax(disp_seq.GetTotal());
disp_seq.SetCurrentPosition(1);
}
// }} ""
// {{ 217 1 0 "965c7df3_0f81_4eb5_a0b3c6059afee706" "{F07B0071-8EFC-11d4-A3BA-002035848439}"
MECC::TraceComment(Translate("**** end pipette_media shard sub-method ****"));
// }} ""
// {{{ 5 "pipette_media" "End"
}
// }} ""
// {{{ 5 "pipette_dil_series" "Begin"
function pipette_dil_series( sequence & from_seq, sequence & to_seq, variable p_vol, variable mix_cycles, variable mix_volume, sequence & tips, variable number_channels, device & STAR ) void {
// }} ""
private variable pipette_counter;
// {{ 5 "pipette_dil_series" "InitLocals"
// }} ""
// {{ 193 1 0 "cd492a49_4c64_4f8e_8775c7994ffe07be" "{F07B0071-8EFC-11d4-A3BA-002035848439}"
MECC::TraceComment(Translate("**** start pipette_dil_series shared sub-method ****"));
// }} ""
// {{{ 194 1 0 "4d87510f_ce14_4488_a6626f0d82b26620" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
TrcTrace(Translate("p_vol: "), p_vol);
// }} ""
// {{{ 195 1 0 "e228f115_c454_4cea_93c12ea2e788fd2b" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
check_same_seq_lengths(from_seq, to_seq);
// }} ""
// {{ 196 1 0 "e7fc9370_d21e_4c1c_83df03646a60038d" "{F07B0071-8EFC-11d4-A3BA-002035848439}"

// }} ""
// {{{ 197 1 0 "ba6d5662_c5f7_4165_b38446bd4ee20f5b" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
tip_pickup(tips, number_channels, STAR);
// }} ""
// {{ 198 1 0 "274359d7_c646_4c3e_a4a5aab006ebdfe0" "{B31F3532-5D80-11d4-A5EB-0050DA737D89}"
{
pipette_counter = 0;
from_seq.SetCurrentPosition(1);
to_seq.SetCurrentPosition(1);
while (
   (from_seq.GetCurrentPosition() > 0)
&& (to_seq.GetCurrentPosition() > 0)
)
{
AlignSequences(hslTrue, from_seq, 1, to_seq, 1);
pipette_counter = pipette_counter + 1;
// }} ""
// {{ 199 1 0 "05a6e94c_b11e_4718_9ec6578a7bf10f02" "STAR:{541143F5-7FA2-11D3-AD85-0004ACB1DCB2}"
{
	variable arrRetValues[];
	arrRetValues = STAR._541143F5_7FA2_11D3_AD85_0004ACB1DCB2("05a6e94c_b11e_4718_9ec6578a7bf10f02"); // Aspirate
}
// }} ""
// {{{ 200 1 0 "ee3026b3_d2b7_4213_ab4c1036a4bdd4b0" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
simple_dispense(to_seq, 1, 1, p_vol, 0, 0, number_channels, STAR);
// }} ""
// {{ 201 1 0 "274359d7_c646_4c3e_a4a5aab006ebdfe0" "{B31F3532-5D80-11d4-A5EB-0050DA737D89}"
if (
   (from_seq.GetCurrentPosition() > 0 && from_seq.GetMax() == 0 )
&& (to_seq.GetCurrentPosition() > 0 && to_seq.GetMax() == 0 )
)
{ MECC::EndlessSequenceLoopWarning(GetFileName()); }

}
from_seq.SetMax(from_seq.GetTotal());
to_seq.SetMax(to_seq.GetTotal());
from_seq.SetCurrentPosition(1);
to_seq.SetCurrentPosition(1);
}
// }} ""
// {{{ 202 1 0 "ba911f1e_02c4_4d06_a54bab7082e178cf" "{7C4EF7A7-39BE-406a-897F-71F3A35B4093}"
tip_eject(number_channels, STAR);
// }} ""
// {{ 203 1 0 "7c042aa2_448e_4336_8cf0eb6f9419577b" "{F07B0071-8EFC-11d4-A3BA-002035848439}"
MECC::TraceComment(Translate("**** end pipette_dil_series shard sub-method ****"));
// }} ""
// {{{ 5 "pipette_dil_series" "End"
}
// }} ""
