// {{ 221 1 0 "86f46114_83a1_4e99_8fc676198d862ace" "{B31F3532-5D80-11d4-A5EB-0050DA737D89}"
{
for(loopCounter1 = 0; loopCounter1 < vol_arr_length;)
{
loopCounter1 = loopCounter1 + 1;
// }} ""
// {{ 222 1 0 "e34ae93e_2802_429a_8e1b344dbf07732f" "{67A8F1C9-6546-41e9-AD2F-3C54F7818853}"
p_vol=p_vol_arr.GetAt(loopCounter1-1);
// }} ""
// {{{ 223 1 0 "efb14194_f7cd_4c2e_bd9885d397aca092" "{C1F3C015-47B3-4514-9407-AC2E65043419}"
TrcTrace4(Translate("    "), loopCounter1, Translate("    p_vol: "), p_vol);
